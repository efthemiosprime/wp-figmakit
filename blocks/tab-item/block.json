{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-figmakit/fk-tab-item",
	"version": "1.0.0",
	"title": "Tab Item",
	"category": "wp-figmakit",
	"icon": "index-card",
	"description": "A single tab with label, optional icon/superscript, and a panel that accepts any blocks.",
	"keywords": ["tab", "panel", "figmakit"],
	"parent": ["wp-figmakit/fk-tabs"],
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Tab"
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconMediaId": {
			"type": "number",
			"default": 0
		},
		"iconMediaUrl": {
			"type": "string",
			"default": ""
		},
		"superscript": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php"
}
