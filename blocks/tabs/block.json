{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-figmakit/fk-tabs",
	"version": "1.0.0",
	"title": "Tabs",
	"category": "wp-figmakit",
	"icon": "table-row-after",
	"description": "Tabbed content with support for icons, superscript, and any inner blocks per panel.",
	"keywords": ["tabs", "tabbed", "figmakit"],
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"variant": {
			"type": "string",
			"default": "horizontal"
		},
		"activeTab": {
			"type": "number",
			"default": 0
		}
	},
	"render": "file:./render.php"
}
